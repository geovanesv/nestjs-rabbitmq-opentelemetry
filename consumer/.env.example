# Variáveis de ambiente do consumer (RFC §5.2) — todas opcionais em dev.

# URL de conexão AMQP (default: guest/guest = padrão de dev do RabbitMQ).
#RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Nome da fila assinada pelo consumer (deve casar com o producer).
#ORDER_QUEUE=orders_queue

# Fila de dead-letter (acoplada ao exchange 'dlx' — D-026).
#ORDER_QUEUE_DLQ=orders_queue.dlq

# Fila de retry com backoff por TTL (expiration por mensagem — D-027).
#ORDER_QUEUE_RETRY=orders_queue.retry

# Reproscessamentos permitidos APÓS a 1ª falha (tentativas = MAX_RETRIES + 1;
# exaustão → nack(requeue=false) → DLQ).
#MAX_RETRIES=3

# TTL base por tentativa em ms (expiration = RETRY_TTL_MS × tentativa).
#RETRY_TTL_MS=2000

# Janela de deduplicação por order.id (ms) — D-029.
#IDEMPOTENCY_TTL_MS=300000

# Capacidade máxima da store de idempotência (evicção FIFO).
#IDEMPOTENCY_MAX_ENTRIES=10000

# Override do atributo service.name enviado ao OTel.
#OTEL_SERVICE_NAME=consumer-service

# Versão do serviço (atributo service.version).
#SERVICE_VERSION=1.0.0

# Ambiente de deployment (atributo deployment.environment).
#NODE_ENV=development

# Taxa de falha injetada no processamento (0..1, default 0). Ex.: 1 = sempre falha.
#SIMULATE_FAILURE_RATE=0

# Endpoint OTLP de traces (prioridade 1 por D-010). Ex. para modo container:
#OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Endpoint base OTLP (prioridade 2 — será anexado /v1/traces).
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Amostragem de traces (always_on em dev; ratio_based + ARG=0.1 em prod).
#OTEL_TRACES_SAMPLER=always_on
#OTEL_TRACES_SAMPLER_ARG=

# Nível de log do aplicativo (log | debug | error).
#LOG_LEVEL=log

# Nível de log do próprio SDK OpenTelemetry.
#OTEL_LOG_LEVEL=info